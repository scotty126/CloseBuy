{
  "name": "closebuy",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @closebuy/api prisma generate",
    "db:migrate": "pnpm --filter @closebuy/api prisma migrate dev",
    "db:validate": "pnpm --filter @closebuy/api prisma validate",
    "db:seed": "pnpm --filter @closebuy/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  }
}
