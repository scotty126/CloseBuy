# Copy to .env on the VM (never commit it) and fill in every value.

# The public hostname that points at this VM, e.g. closebuy-api.duckdns.org
API_DOMAIN=
API_PUBLIC_URL=https://closebuy-api.duckdns.org

# Neon: Connection Details page. Pooled string for DATABASE_URL, unpooled for DIRECT_URL.
DATABASE_URL=
DIRECT_URL=

# Generate each with: openssl rand -base64 48
# PASSWORD_PEPPER must equal the old value or existing password logins break.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
PASSWORD_PEPPER=

# Your four Cloudflare app URLs (no trailing slash)
CUSTOMER_APP_URL=
VENDOR_APP_URL=
RIDER_APP_URL=
ADMIN_APP_URL=
CORS_ORIGINS=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
DEV_AUTO_SIGNIN_PHONES=
RESEND_API_KEY=
TERMII_API_KEY=
