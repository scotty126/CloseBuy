# Copy this file to .env in the repo root, fill in real values, and never commit .env
# (already covered by .gitignore). apps/api reads these; the client apps only
# read the NEXT_PUBLIC_* ones, set per-app in apps/*/.env.local.

# ── Needed to run M0 (auth, schema, UI shell) ──────────────────────────────

# Local Postgres via `docker compose up -d` matches these exactly. Using a
# hosted Postgres instead (e.g. Neon)? DATABASE_URL is the pooled
# connection string (PgBouncer) the app uses at runtime; DIRECT_URL is the
# unpooled one `prisma migrate`/`db push` need — Neon gives you both on
# the project's Connection Details page. For a plain local Postgres
# (Docker or otherwise, no pooler in front of it), both are just the same
# value.
DATABASE_URL="postgresql://closebuy_app:localdev@localhost:5432/closebuy"
DIRECT_URL="postgresql://closebuy_app:localdev@localhost:5432/closebuy"
REDIS_URL="redis://localhost:6379"

# Any random 32+ character string for local dev. Generate a real one for
# staging/production with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me-to-something-random-and-long"
JWT_REFRESH_SECRET="dev-only-change-me-to-something-else-random-and-long"
PASSWORD_PEPPER="dev-only-change-me-to-something-random-and-long-too"

# Free account at https://termii.com — sandbox mode works for local dev
# without a paid sender ID. Needed for vendor/rider/admin OTP sign-in and
# for guest order tracking links sent by SMS (US-C-06a). NOT needed for
# customer sign-in/sign-up any more — that's email/password + OAuth now,
# see below (brief §3.1b).
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# TERMII_SENDER_ID needs CAC business verification, which can take a
# while — set this to "true" to exercise the real OTP request/verify
# flow (lockout included) without it: a real 6-digit code gets logged
# and handed back in the /auth/otp/request response instead of an SMS
# being sent. Opt-in only, never automatic. Once TERMII_API_KEY and
# TERMII_SENDER_ID are both real, this stops being read — no need to
# ever unset it.
OTP_DEV_FALLBACK="false"

# E.164 phone number to seed as the one admin account on `pnpm db:seed`
# (local dev only — admin sign-in is never self-service, unlike vendor/
# rider, see apps/api/src/modules/auth/service.ts). Leave blank and Admin
# stays unreachable locally until you set this and re-seed.
SEED_ADMIN_PHONE=""

# Free account at https://resend.com — customer email verification and
# password-reset links (brief §3.1b). Without this, customer signup still
# works, it just won't be able to send the verification/reset email.
RESEND_API_KEY=""

# Google OAuth client — https://console.cloud.google.com, create an OAuth
# 2.0 Client ID (Web application), redirect URI
# {API_URL}/auth/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""

# Apple "Sign in with Apple" — needs a paid Apple Developer account
# ($99/year) to configure, unlike everything else on this list. Fine to
# leave blank until that's actually set up; the button can stay hidden
# until then rather than blocking on it.
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_TEAM_ID=""
APPLE_OAUTH_KEY_ID=""
APPLE_OAUTH_PRIVATE_KEY=""

# This API's own publicly-reachable URL — used to build the OAuth redirect
# URIs above, and must exactly match what's registered with Google/Apple.
# The default is correct for local dev.
API_PUBLIC_URL="http://localhost:4000"

# Where the customer app lives — verify-email, reset-password and the
# OAuth-complete landing page all link back here. Default is correct for
# local dev.
CUSTOMER_APP_URL="http://localhost:3000"

# Monnify sandbox — https://developers.monnify.com (ADR-0001, primary
# payment gateway). Only card/transfer checkout needs this; cash on
# delivery works fully without it, and proves the rest of the order
# lifecycle (accept/reject/ready/pickup, the escrow ledger, the auto-reject
# and escrow-release timers) end to end on its own.
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

# Vendor payouts (admin-approved withdrawal requests) need the Monnify
# account to have API disbursements enabled and OTP disabled — email
# Monnify support — plus a whitelisted static outbound IP. This is which
# Monnify wallet/account the transfer draws from.
MONNIFY_DISBURSEMENT_SOURCE_ACCOUNT_NUMBER=""

# ── Not needed until later — the app boots and everything above works fully without these ──

# Google Maps Platform — Geocoding + Places Autocomplete + Maps, for
# pin-drop addressing (brief §3.4). https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=""

# Cloudflare R2 (product images, KYC documents) — https://dash.cloudflare.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys.
# Optional: the Notifications module works fully without these (the
# in-app feed via GET /notifications is real either way, US-A-08/R-07)
# — this only adds actual push delivery to a subscribed device.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@closebuy.app"
