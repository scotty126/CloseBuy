# Copy this file to .env in the repo root, fill in real values, and never commit .env
# (already covered by .gitignore). apps/api reads these; the client apps only
# read the NEXT_PUBLIC_* ones, set per-app in apps/*/.env.local.

# ── Needed to run M0 (auth, schema, UI shell) ──────────────────────────────

# Local Postgres via `docker compose up -d` matches these exactly.
DATABASE_URL="postgresql://closebuy_app:localdev@localhost:5432/closebuy"
REDIS_URL="redis://localhost:6379"

# Any random 32+ character string for local dev. Generate a real one for
# staging/production with: openssl rand -base64 48
JWT_ACCESS_SECRET="dev-only-change-me-to-something-random-and-long"
JWT_REFRESH_SECRET="dev-only-change-me-to-something-else-random-and-long"

# Free account at https://termii.com — sandbox mode works for local dev
# without a paid sender ID. This is the one external account you genuinely
# need before OTP login does anything real; without it, /auth/otp/request
# will fail at the Termii call, which is the correct, loud failure — not a
# silent no-op.
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# ── Not needed until M1 — the app boots and M0 works fully without these ──

# Monnify (ADR-0001, primary payment gateway) — https://developers.monnify.com
MONNIFY_API_KEY=""
MONNIFY_SECRET_KEY=""
MONNIFY_CONTRACT_CODE=""

# Google Maps Platform — Geocoding + Places Autocomplete + Maps, for
# pin-drop addressing (brief §3.4). https://console.cloud.google.com
GOOGLE_MAPS_API_KEY=""

# Cloudflare R2 (product images, KYC documents) — https://dash.cloudflare.com
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
